{
  "$schema": "../gen/schemas/config-schema.json",
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**"
          ]
        }
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "AppMaka",
        "width": 680,
        "height": 480,
        "transparent": true
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "fragmentPaths": [
          "wix/close-app.wxs"
        ]
      }
    }
  },
  "identifier": "com.appforge.app",
  "productName": "AppMaka",
  "version": "0.18.5",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "https"
        ]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERDQzQUU3RjAxQ0EwNDEKUldSQm9Cenc1enJVL1Jsbmw5RGllM0llNWdoc3VhT3dQZmpCL0VYVUNJRUpBYVJLL0tKWGF1NEoK",
      "endpoints": [
        "https://codeberg.org/crtGhoul/appmaka/raw/branch/main/latest.json",
        "https://github.com/crtGhoul/appmaka/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
